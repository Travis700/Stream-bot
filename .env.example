# ---- Discord (create two applications at https://discord.com/developers/applications) ----
DISCORD_CLIPPER_TOKEN=
DISCORD_RATER_TOKEN=
# Your server's ID: slash commands appear instantly there (leave empty for global sync, ~1 hour)
DISCORD_GUILD_ID=

# ---- Claude (picks clip moments, checks clipping rules, rates clips) ----
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

# ---- Clips ----
CLIP_MIN_SECONDS=120
CLIP_MAX_SECONDS=150
CLIPS_PER_VOD=4
CLIP_RETENTION_DAYS=7
# Speech-to-text model: tiny | base | small | medium (bigger = more accurate, slower on CPU)
WHISPER_MODEL=small
# x264 preset: ultrafast | superfast | veryfast | faster | fast | medium
RENDER_PRESET=veryfast

# ---- Download links for full-quality clips (Discord uploads are capped at 10 MB) ----
# http://<your-oracle-public-ip>:8080  (open the port in the VCN security list + firewall)
PUBLIC_BASE_URL=
FILE_SERVER_PORT=8080

# ---- Polling ----
VOD_POLL_MINUTES=30
CLIPPER_POLL_MINUTES=60
REFERENCE_POLL_MINUTES=180
RATER_MIN_REFERENCE_VIEWS=100000

# ---- Optional: cookies.txt for yt-dlp (Instagram needs it; YouTube often does from cloud IPs) ----
# Put the file in ./data and use the in-container path:
YTDLP_COOKIES=
